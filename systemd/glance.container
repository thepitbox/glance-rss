[Unit]
Description=Glance dashboard
Wants=network-online.target
After=network-online.target

[Container]
# Built by .github/workflows/container-image.yaml on every push to main
Image=ghcr.io/thepitbox/glance-rss:latest
# Pull new builds automatically, requires: sudo systemctl enable --now podman-auto-update.timer
AutoUpdate=registry
ContainerName=glance
PublishPort=8002:8080
# Must stay writable, the feeds editor (/feeds) saves changes to glance.yml in here
Volume=/etc/thepitbox/glance/config:/app/config
Environment=TZ=Europe/Berlin

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
